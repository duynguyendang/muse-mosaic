# Muse Mosaic configuration (CSD 12.3).
# Copy to .env for local Docker Compose use. Never commit .env.
# No model id, embedding model id or threshold is defaulted in code.

# true: local deterministic fixtures only (safe for contract tests).
# false: real Muse Spark via the Meta Model API; requires both values below.
USE_MOCK_MUSE=true

# Server-side only. Never in the repository, frontend JS or demo video.
META_MODEL_API_KEY=

# Meta Model API base URL (OpenAI-compatible). Default is the documented
# https://api.meta.ai/v1; override only to point at a compatible endpoint.
META_MODEL_API_BASE_URL=https://api.meta.ai/v1

# No default in code. In real mode, startup fails fast if this is empty.
MUSE_MODEL_ID=

# Pin all three before demo recording. Must not mix vectors across models/versions.
EMBEDDING_MODEL=
EMBEDDING_VERSION=
EMBEDDING_DIM=

# Microservice mode. Local default is http://127.0.0.1:8080/derive; compose
# overrides this to http://trust-engine:8080/derive on the internal network.
TRUST_ENGINE_URL=http://127.0.0.1:8080/derive

# Path to the pinned manglekit binary for the trust-engine's `mkit eval`
# calls. Empty = "mkit" on PATH (the compose image bakes the pinned build in;
# local runs need MANGLEKIT_BIN or mkit on PATH — see scripts/kaggle_e2e.py).
MANGLEKIT_BIN=

# SQLite ledger path. Compose uses /app/state/mosaic.db.
DATABASE_PATH=./data/mosaic.db

# Splink matcher (proposer only). false = Muse + fuzzy fallback, marked SPLINK_UNAVAILABLE.
SPLINK_ENABLED=true

# Splink matching engine base URL (no path). Compose points this at the
# internal matching-engine; the client calls POST {base}/match and GET {base}/health.
MATCHING_ENGINE_URL=http://127.0.0.1:8081

# Optional: Muse Wonder adjudication on escalations only. Unset = labelled stub, never simulated.
WONDER_MODEL_ID=

# Taxonomy directory (versioned JSON + steward-accepted new versions).
# Defaults to baked-in data/mock/taxonomy; override for tests/demos.
TAXONOMY_DIR=
# Where the entity schema contracts (data/schemas/*.json) are read from.
# Empty = repo data/schemas. A new entity type is a JSON drop there, or in SPECS_DIR.
# SPECS_DIR=

# Policy directory (versioned JSON + .mg rules, read-only mirror in mosaic-api).
# Defaults to the baked-in trust-engine/policies; override with a composed tree
# (e.g. repo policies plus a staged new version) without touching the repo.
POLICY_DIR=

# --- Autonomy (unattended operation) ---
# manual: jobs only via explicit API calls; no inbox polling. supervised:
# inbox poller and periodic analyser may also run (each needs its own
# setting below). Budgets are always enforced.
AUTONOMY_MODE=manual

# Max attempts per job before it fails permanently (transient 503s retry
# with backoff; 409/422 contract violations fail immediately).
JOB_MAX_ATTEMPTS=3

# Muse token budgets (Meta-reported totals, 0 = unlimited). Mock mode reports
# 0, so budgets only bite in real mode. Exceeding stops the job as failed —
# never a partial publish beyond what already derived.
MUSE_JOB_TOKEN_BUDGET=0
MUSE_DAILY_TOKEN_BUDGET=0

# Inbox directory for unattended intake (JSON build requests). Empty =
# disabled. Files move to processed/ or failed/ subdirectories.
INBOX_DIR=
INBOX_POLL_SECONDS=30

# Hygiene analyser interval in seconds (orphans/stale/duplicates + overdue
# stewards). 0 = disabled.
ANALYSER_INTERVAL_SECONDS=0

# Steward notifications (signed webhook POST on terminal escalated/failed/
# denied jobs and overdue digests). Empty URL = log only, never fails a job.
STEWARD_WEBHOOK_URL=
STEWARD_WEBHOOK_SECRET=

# Inbound ingest webhook secret. Empty = POST /ingest/webhook disabled (503).
INGEST_WEBHOOK_SECRET=

# Background tasks (worker, inbox, analyser loops). Tests disable these and
# drive run_job_once directly for determinism.
ENABLE_BACKGROUND_TASKS=true

# Bearer token required on every state-changing request (steward approve/reject,
# jobs, uploads, policy apply). Leave empty only for local development.
MOSAIC_API_TOKEN=

# Opt-in: Muse proposes near-match cluster merges (same person, different phone
# AND email) that exact-identifier blocking misses. The trust-engine verifies the
# identifier evidence itself (policy rules S1/S2) and holds merges that rest on
# names alone (S3), so a model's say-so never certifies a value. Off by default
# (it changes cluster counts).
MUSE_CANDIDATE_MATCHING=false
# Candidate-matching scale (10k-100k clusters):
#   MUSE_CANDIDATE_MAX_PAIRS=0     0 = no global cap; per-cluster still bounds cost
#   MUSE_CANDIDATE_PER_CLUSTER=0   0 = each entity type's admission policy decides
#                                (product/publication 5, person 3); a positive
#                                number caps every entity type from above
#   MUSE_JUDGE_CONCURRENCY=8       judge batches run in parallel
#   MUSE_VERDICT_CACHE=true        reuse verdicts for identical name+address pairs
MUSE_CANDIDATE_MAX_PAIRS=0
MUSE_CANDIDATE_PER_CLUSTER=0
MUSE_JUDGE_CONCURRENCY=8
MUSE_VERDICT_CACHE=true
# Blocking for the shortlist. token (default): single name tokens, so words shared by
# more than 50 clusters block nothing (this empties the shortlist for most Vietnamese
# names at 10k+). rarest_pair: also token pairs and exact address; recovered 481/500
# on a 10k Vietnamese set (0/500 with token) but judges ~1.8x more pairs on the
# benchmark. MUSE_BLOCKING_MAX_BLOCK=0 keeps the built-in 50.
MUSE_BLOCKING_MODE=token
MUSE_BLOCKING_MAX_BLOCK=0
# Lowest judge confidence that may merge clusters: high (default) or medium.
# medium raised recall on the hard-name benchmark with no false merges there, but
# that test is small and synthetic; keep high unless you have measured yours.
MUSE_CANDIDATE_MIN_CONFIDENCE=high

# Extend the product taxonomy with evidence-verified terms before deriving:
# off (default) | rules (no model) | muse (a model proposes). Either way a term
# or synonym is accepted only if the data verifies it (it occurs, has enough
# records, and relates to the term by case/leet/prefix/one-typo rules); a model's
# confidence never decides. Accepted terms are written as a NEW taxonomy version.
MUSE_TAXONOMY_PROPOSALS=off
TAXONOMY_MIN_SUPPORT=3
